---
interface Props {
  type: string;
  size?: number;
}

const { type, size = 56 } = Astro.props;
---

<div class="app-squircle" style={`width: ${size}px; height: ${size}px;`}>
  {type === 'labbet' && (
    <div class="w-full h-full bg-[#0e0e11] flex items-center justify-center p-2.5 rounded-[15px] shadow-sm">
      <img src="/images/labbet.svg" alt="Labbet" class="w-full h-full object-contain filter brightness-0 invert" />
    </div>
  )}

  {type === 'chatgpt' && (
    <div class="w-full h-full bg-[#10A37F] flex items-center justify-center rounded-[15px] p-2.5 shadow-sm">
      <img src="/images/openai.svg" alt="ChatGPT" class="w-full h-full object-contain filter brightness-0 invert" />
    </div>
  )}

  {type === 'gemini' && (
    <div class="w-full h-full bg-[#ffffff] border border-black/8 flex items-center justify-center rounded-[15px] p-2.5 shadow-sm">
      <img src="/images/gemini-color.svg" alt="Gemini" class="w-full h-full object-contain" />
    </div>
  )}

  {type === 'vsco' && (
    <div class="w-full h-full bg-[#18181A] flex items-center justify-center text-white rounded-[15px]">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="9" />
        <circle cx="12" cy="12" r="5" />
        <circle cx="12" cy="12" r="1.5" fill="currentColor" />
        <line x1="12" y1="3" x2="12" y2="7" />
        <line x1="12" y1="17" x2="12" y2="21" />
        <line x1="3" y1="12" x2="7" y2="12" />
        <line x1="17" y1="12" x2="21" y2="12" />
      </svg>
    </div>
  )}

  {type === 'google-one' && (
    <div class="w-full h-full bg-white flex items-center justify-center border border-neutral-200 rounded-[15px]">
      <svg width="26" height="26" viewBox="0 0 48 48">
        <path fill="#4285F4" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
        <path fill="#34A853" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
        <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
        <path fill="#EA4335" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
      </svg>
    </div>
  )}

  {type === 'canva' && (
    <div class="w-full h-full bg-gradient-to-tr from-[#00C4CC] to-[#7D2AE8] flex items-center justify-center text-white rounded-[15px]">
      <span class="font-serif italic font-bold text-xl select-none">C</span>
    </div>
  )}

  {type === 'capcut' && (
    <div class="w-full h-full bg-black flex items-center justify-center text-white rounded-[15px]">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
        <path d="M19.3 5.4l-4.5 4.5 4.5 4.5c.8.8.8 2 0 2.8s-2 .8-2.8 0l-5.9-5.9c-.8-.8-.8-2 0-2.8l5.9-5.9c.8-.8 2-.8 2.8 0s.8 2 0 2.8zM4.7 18.6l4.5-4.5-4.5-4.5c-.8-.8-.8-2 0-2.8s2-.8 2.8 0l5.9 5.9c.8.8.8 2 0 2.8l-5.9 5.9c-.8.8-2 .8-2.8 0s-.8-2 0-2.8z"/>
      </svg>
    </div>
  )}

  {type === 'lightroom' && (
    <div class="w-full h-full bg-[#001E36] flex items-center justify-center text-[#31A8FF] rounded-[15px]">
      <span class="font-bold text-base select-none">Lr</span>
    </div>
  )}
</div>

---
// Filtory - Platform Kurasi Aplikasi Kreatif & AI Premium
import '../styles/helumi-landing.css';
import { PRODUCTS, TRUST_POINTS, TESTIMONIALS, FAQS } from '../data/products';
import ProductAccordion from '../components/ProductAccordion.astro';

const WA_LINK = "https://wa.me/62816957050";
const SHOPEE_LINK = "https://s.shopee.co.id/1gG3IthAYI";
---

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Filtory: Akses Aplikasi Premium & AI Pilihan Tanpa Boncos</title>
  <meta name="description" content="Akses aplikasi pro & AI terbaik: Labbet, CapCut Pro, Canva Pro, ChatGPT Plus, VSCO Pro. Bayar sekali, bergaransi penuh, aktif dalam hitungan menit." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <div style="display:contents">
    <!-- 1. NAVBAR (FLOATING PILL) -->
    <nav class="nav" aria-label="Main">
      <a href="#top" class="nav-home on">filtory</a>
      <a href="#katalog">katalog</a>
      <a href="#kenapa-kami">kenapa kami</a>
      <a href="#testimoni">testimoni</a>
      <a href="#jalur-order">cara order</a>
      <a href="#faq">faq</a>
      <a class="nav-account" href={WA_LINK} target="_blank" rel="noopener">chat admin</a>
    </nav>

    <main id="top">
      <!-- 2. HERO SECTION -->
      <section class="hero wrap">
        <h1 class="hero-title">
          <span>akses aplikasi</span>
          <span class="hero-tile" aria-hidden="true">
            <svg width="40" height="30" viewBox="307 495 1434 1063" fill="currentColor">
              <path d="M 1074.5 495.6 C 952 517.9 696.8 596.3 610.7 682.7 C 574 790 565.1 1029.5 557.5 1215.5 C 668.2 1063 885 841.8 1093.5 795.5 C 1336.5 744.1 1544 696.4 1544 675.1 C 1544 618 1338 629.4 1242.4 634.7 C 1218 594.5 1181.2 523.6 1074.5 495.6 Z M 1549.5 749.1 C 1318.5 793.5 940.7 877.3 796.5 958.8 C 692.8 1122.5 589.4 1418.9 611.6 1471.3 C 661.3 1530 789 1557.7 1001.5 1529.4 C 1458.5 1442.9 1648.3 1321.1 1704.4 1181.5 C 1739.5 959.5 1716.3 836.9 1549.5 749.1 Z"></path>
            </svg>
          </span>
          <span><em>premium</em>.</span>
        </h1>
        <p class="lede" style="max-width: 580px;">
          <strong>tanpa harga resmi</strong> yang <mark>menguras kantong</mark>. Nggak perlu bayar ratusan ribu tiap bulan. Pilih aplikasinya di bawah, bayar sekali, dan langsung pakai dalam hitungan menit. Bergaransi penuh.
        </p>

        <div style="display:flex; gap:12px; align-items:center; flex-wrap:wrap; justify-content:center;">
          <a class="pill pill-dark" href="#katalog">
            lihat katalog harga ↓
          </a>
          <a class="pill" style="background:#ffffff; border:1px solid var(--border); box-shadow:var(--shadow-sm);" href={WA_LINK} target="_blank" rel="noopener">
            tanya via whatsapp →
          </a>
        </div>

        <p class="fine">⚡ proses 5–10 menit · 🛡️ garansi full durasi · ⭐ 100+ pembeli aktif</p>

        <p class="lifetime done stacked">
          <span class="lt-stack">
            <img src="/avatars/1.svg" alt="">
            <img src="/avatars/2.svg" alt="">
            <img src="/avatars/3.svg" alt="">
            <img src="/avatars/4.svg" alt="">
            <img src="/avatars/5.svg" alt="">
            <img src="/avatars/6.svg" alt="">
          </span>
          <span>dipercaya oleh <b>100+ kreator & profesional</b> 🎉</span>
        </p>
      </section>

      <!-- 3. KATALOG APLIKASI (EXPANDABLE ACCORDION CARD) -->
      <section id="katalog" class="section wrap centered">
        <h2>pilih <em>aplikasi</em> yang kamu butuhkan.</h2>
        <p class="body">klik pada nama aplikasi untuk melihat detail paket, sistem akun, dan tombol pemesanan.</p>

        <!-- ACCORDION LIST: LABBET EXPANDED SECARA DEFAULT -->
        <ProductAccordion products={PRODUCTS} initialExpandedId="labbet-premium" />
      </section>

      <!-- 4. KENAPA BELI DI FILTORY? (3 BENTO CARDS) -->
      <section id="kenapa-kami" class="section wrap centered">
        <h2>kenapa beli di <em>Filtory?</em></h2>
        <p class="body">kami nggak cuma jualan akses, tapi memastikan akunmu tetap lancar dipakai sampai hari terakhir.</p>

        <div class="trust-grid">
          {TRUST_POINTS.map((item) => (
            <div class="trust-card">
              <span class="trust-icon">{item.icon}</span>
              <h3 class="trust-title">{item.title}</h3>
              <p class="trust-desc">{item.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- 5. TESTIMONI (KATA MEREKA YANG SUDAH BERLANGGANAN) -->
      <section id="testimoni" class="section wrap centered">
        <h2>kata mereka yang sudah <em>berlangganan.</em></h2>
        <p class="body">ratusan pesanan selesai dengan rating 5.0 di WhatsApp dan Shopee.</p>

        <div class="says">
          <div class="says-row">
            <div class="says-track" style="--says-time:48s">
              <div class="says-copy">
                {TESTIMONIALS.map((t) => (
                  <div class="say">
                    <p class="say-quote">“{t.quote}”</p>
                    <div class="say-who">
                      <div class="say-name">
                        <b>{t.name}</b>
                        <span>{t.source}</span>
                      </div>
                      <span class="say-x" style="font-size:11px; font-weight:600; color:var(--accent);">
                        {t.channel === 'WA' ? 'WhatsApp' : 'Shopee'}
                      </span>
                    </div>
                  </div>
                ))}
              </div>
              <div class="says-copy" aria-hidden="true">
                {TESTIMONIALS.map((t) => (
                  <div class="say">
                    <p class="say-quote">“{t.quote}”</p>
                    <div class="say-who">
                      <div class="say-name">
                        <b>{t.name}</b>
                        <span>{t.source}</span>
                      </div>
                      <span class="say-x" style="font-size:11px; font-weight:600; color:var(--accent);">
                        {t.channel === 'WA' ? 'WhatsApp' : 'Shopee'}
                      </span>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 6. DUA JALUR ORDER (MENGGANTIKAN PRICING SLIDER LAMA) -->
      <section id="jalur-order" class="section wrap centered">
        <h2>dua jalur order, pilih yang paling <em>nyaman.</em></h2>
        <p class="body">mau proses instan langsung ke HP, atau bayar pakai koin & potongan di marketplace? Bebas pilih.</p>

        <div class="channel-grid">
          <!-- OPSI 1: WHATSAPP -->
          <div class="channel-card highlight">
            <div>
              <span class="channel-badge">⚡ Paling Cepat & Populer</span>
              <div class="channel-head">
                <h3>Order via WhatsApp</h3>
                <p>Rekomendasi untuk aktivasi kilat tanpa ribet.</p>
              </div>

              <div class="channel-list">
                <div class="channel-item">
                  <span>⚡</span>
                  <span>Proses paling instan, langsung ditangani admin via chat</span>
                </div>
                <div class="channel-item">
                  <span>💬</span>
                  <span>Bisa konsultasi atau tanya stok paket sebelum transaksi</span>
                </div>
                <div class="channel-item">
                  <span>💳</span>
                  <span>Pembayaran bebas biaya via QRIS, GoPay, DANA, OVO & Bank</span>
                </div>
              </div>
            </div>

            <a class="pill pill-dark channel-cta" href={WA_LINK} target="_blank" rel="noopener">
              Chat WhatsApp Sekarang →
            </a>
          </div>

          <!-- OPSI 2: SHOPEE -->
          <div class="channel-card">
            <div>
              <span class="channel-badge marketplace">🛍️ Marketplace Rekber</span>
              <div class="channel-head">
                <h3>Order via Shopee</h3>
                <p>Untuk kamu yang mengutamakan proteksi marketplace.</p>
              </div>

              <div class="channel-list">
                <div class="channel-item">
                  <span>🛡️</span>
                  <span>Transaksi aman via sistem rekening bersama resmi Shopee</span>
                </div>
                <div class="channel-item">
                  <span>🎟️</span>
                  <span>Bisa manfaatkan koin Shopee, voucher diskon & ShopeePay</span>
                </div>
                <div class="channel-item">
                  <span>📦</span>
                  <span>Detail akun & panduan tetap dikirimkan kilat via chat</span>
                </div>
              </div>
            </div>

            <a class="pill channel-cta" style="background:#f5f5f7; border:1px solid var(--border); color:var(--text);" href={SHOPEE_LINK} target="_blank" rel="noopener">
              Kunjungi Toko Shopee →
            </a>
          </div>
        </div>
      </section>

      <!-- 7. FAQ ACCORDION -->
      <section id="faq" class="section wrap centered">
        <h2>hal yang sering <em>ditanyakan.</em></h2>
        <p class="body">jawaban lengkap seputar keamanan, legalitas, dan sistem garansi Filtory.</p>

        <div class="faq-container">
          {FAQS.map((faq) => (
            <details class="faq-item">
              <summary>{faq.q}</summary>
              <p>{faq.a}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- 8. BOTTOM CTA BANNER -->
      <section id="order" class="ending wrap">
        <h2>berhenti bayar mahal<br>untuk fitur yang <em>sama.</em></h2>
        <p class="body">pilih aplikasi yang kamu butuhkan sekarang, atau tanya admin kalau masih bingung memilih paket yang pas.</p>
        <a class="pill pill-dark" href={WA_LINK} target="_blank" rel="noopener">
          chat admin via whatsapp →
        </a>
        <p class="fine">⚡ fast response · garansi aktif penuh · 100% legal & aman</p>
      </section>
    </main>

    <!-- FOOTER -->
    <footer class="foot">
      <p>
        <a href={WA_LINK} target="_blank" rel="noopener">whatsapp</a><span>·</span>
        <a href={SHOPEE_LINK} target="_blank" rel="noopener">shopee</a><span>·</span>
        <a href="#katalog">katalog</a><span>·</span>
        <a href="#faq">syarat & garansi</a><span>·</span>
        © 2026 Filtory.web.id
      </p>
    </footer>
  </div>

  <script is:inline>
    // Nav active link tracking on scroll
    function initNavSpy() {
      const sections = document.querySelectorAll('main section[id], main[id]');
      const navLinks = document.querySelectorAll('.nav a[href^="#"]');

      function updateActive() {
        const scrollY = window.scrollY + 140;
        let activeId = 'top';

        sections.forEach((sec) => {
          const top = sec.offsetTop;
          const height = sec.offsetHeight;
          if (scrollY >= top && scrollY < top + height) {
            activeId = sec.getAttribute('id') || 'top';
          }
        });

        navLinks.forEach((link) => {
          const href = link.getAttribute('href');
          if (href === `#${activeId}`) {
            link.classList.add('on');
          } else {
            link.classList.remove('on');
          }
        });
      }

      window.addEventListener('scroll', updateActive, { passive: true });
      updateActive();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initNavSpy);
    } else {
      initNavSpy();
    }
  </script>
</body>
</html>
